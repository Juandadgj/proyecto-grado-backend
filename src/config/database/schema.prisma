generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  username       String   @unique
  ratings        Rating[]
}

model Rating {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  game       String
  userId     String    @db.ObjectId
  user       User      @relation(fields: [userId], references: [id])
  score      Float
}

